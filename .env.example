# Resend — kirim email dari form kontak
# Ambil API key di https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Alamat penerima pesan (default: site.email di src/lib/site.ts)
CONTACT_TO_EMAIL=aldisuryasaputra693@gmail.com

# Alamat pengirim.
# - Untuk testing, gunakan "Portfolio <onboarding@resend.dev>" (hanya bisa kirim ke email pemilik akun Resend).
# - Setelah domain diverifikasi di Resend, ganti dengan domainmu, mis. "Portfolio <noreply@domainmu.com>".
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
